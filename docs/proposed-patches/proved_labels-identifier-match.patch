+def named(short, s):
+    """True only if the page names the declaration as a declaration, not as an English word.
+    A name that is identifier-shaped (underscore, digit, prime, or an interior capital) matches
+    as a bare word. A plain all-lowercase name (e.g. 'discriminant') must appear inside a
+    <code>...</code> element, so ordinary prose or a nav title cannot pull in an unrelated proof."""
+    w = re.compile(r"\b" + re.escape(short) + r"\b")
+    if re.search(r"[_0-9'!?]|[a-z][A-Z]", short):
+        return bool(w.search(s))
+    for m in re.finditer(r"(?is)<code[^>]*>(.*?)</code>", s):
+        if w.search(m.group(1)): return True
+    return False
+
