+STDLIB = set(getattr(sys, 'stdlib_module_names', ())) | {'__future__'}
+PIPNAME = {'sklearn': 'scikit-learn', 'yaml': 'pyyaml', 'PIL': 'pillow', 'cv2': 'opencv-python'}
+
+def third_party(files):
+    """Top-level imports of the named .py files that are neither stdlib nor a sibling file."""
+    import ast
+    libs = set()
+    for f in files:
+        if not f.endswith('.py'): continue
+        try: tree = ast.parse(open(os.path.join(ROOT, f), encoding='utf-8', errors='replace').read())
+        except SyntaxError: continue
+        for n in ast.walk(tree):
+            mods = [a.name for a in n.names] if isinstance(n, ast.Import) else \
+                   [n.module] if isinstance(n, ast.ImportFrom) and n.module and n.level == 0 else []
+            for m in mods:
+                top = m.split('.')[0]
+                if top in STDLIB: continue
+                if os.path.isfile(os.path.join(ROOT, os.path.dirname(f), top + '.py')): continue
+                if os.path.isfile(os.path.join(ROOT, 'tools', top + '.py')): continue
+                libs.add(PIPNAME.get(top, top))
+    return sorted(libs)
