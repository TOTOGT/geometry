import Mathlib

/-!
# A counterexample to the Jacobian conjecture in dimension 3 (Alpoge's map, in Gao's form)

STATUS (2026-11-11): WRITTEN, NOT YET COMPILED. No Lean was available to the session that
wrote this file. It is a build target in `lakefile.lean` but NOT a default target, and it is
run only by the manual workflow `.github/workflows/jacobian-lean.yml`. By R22 it counts as
evidence only after that run is green and its `#print axioms` output is committed.

The map F = (f1, f2, f3) : Q^3 -> Q^3 is the one in Gao, arXiv:2608.00222, Thm 3.3:
  f1 = (1+xy)^3 z + y^2 (1+xy)(4+3xy)
  f2 = y + 3x(1+xy)^2 z + 3x y^2 (4+3xy)
  f3 = 2x - 3x^2 y - x^3 z
Its Jacobian determinant is the constant -2, and F(0,0,-1/4) = F(1,-3/2,13/2) =
F(-1,3/2,13/2) = (-1/4,0,0). Both facts were re-derived with SymPy (exact arithmetic) in
`book7/jacobian-verification-verify.py`. The nine partial derivatives below were generated by
SymPy, not typed by hand.

What this file claims once it compiles: the polynomial identity and the three-point collision
over Q. It does not claim anything about dimension 2 and it does not claim the map was
discovered here.
-/

open MvPolynomial

namespace JacobianCE

abbrev R := MvPolynomial (Fin 3) ℚ

noncomputable abbrev x : R := X 0
noncomputable abbrev y : R := X 1
noncomputable abbrev z : R := X 2

noncomputable def f1 : R := (1 + x*y)^3 * z + y^2 * (1 + x*y) * (4 + 3*x*y)
noncomputable def f2 : R := y + 3*x*(1 + x*y)^2 * z + 3*x*y^2 * (4 + 3*x*y)
noncomputable def f3 : R := 2*x - 3*x^2*y - x^3*z

noncomputable def F : Fin 3 → R := ![f1, f2, f3]

/-- Jacobian matrix, row i = gradient of F i. -/
noncomputable def jacobianMatrix : Matrix (Fin 3) (Fin 3) R :=
  Matrix.of fun i j => pderiv j (F i)

/-! ## The nine partial derivatives (explicit) -/

/-- Derivatives of the numeral literals 2, 3, 4 vanish. CI run #1 of jacobian-lean.yml (d9782d0)
    left `pderiv i 2`, `pderiv i 3`, `pderiv i 4` unsolved in the nine partials. -/
theorem pd_two (i : Fin 3) : pderiv i (2 : R) = 0 := by
  have h : (2 : R) = C (2 : ℚ) := by simp
  rw [h]
  first | exact pderiv_C | simp

theorem pd_three (i : Fin 3) : pderiv i (3 : R) = 0 := by
  have h : (3 : R) = C (3 : ℚ) := by simp
  rw [h]
  first | exact pderiv_C | simp

theorem pd_four (i : Fin 3) : pderiv i (4 : R) = 0 := by
  have h : (4 : R) = C (4 : ℚ) := by simp
  rw [h]
  first | exact pderiv_C | simp

section partials

theorem d_f1_x : pderiv 0 f1 = 3*x^2*y^3*z + 6*x*y^4 + 6*x*y^2*z + 7*y^3 + 3*y*z := by
  simp [f1, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f1_y : pderiv 1 f1 = 3*x^3*y^2*z + 12*x^2*y^3 + 6*x^2*y*z + 21*x*y^2 + 3*x*z + 8*y := by
  simp [f1, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f1_z : pderiv 2 f1 = x^3*y^3 + 3*x^2*y^2 + 3*x*y + 1 := by
  simp [f1, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f2_x : pderiv 0 f2 = 9*x^2*y^2*z + 18*x*y^3 + 12*x*y*z + 12*y^2 + 3*z := by
  simp [f2, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f2_y : pderiv 1 f2 = 6*x^3*y*z + 27*x^2*y^2 + 6*x^2*z + 24*x*y + 1 := by
  simp [f2, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f2_z : pderiv 2 f2 = 3*x^3*y^2 + 6*x^2*y + 3*x := by
  simp [f2, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f3_x : pderiv 0 f3 = -3*x^2*z - 6*x*y + 2 := by
  simp [f3, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f3_y : pderiv 1 f3 = -3*x^2 := by
  simp [f3, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

theorem d_f3_z : pderiv 2 f3 = -x^3 := by
  simp [f3, x, y, z, pderiv_X, pd_two, pd_three, pd_four] <;> ring

end partials

/-- The same matrix with the partials written out. -/
noncomputable def J : Matrix (Fin 3) (Fin 3) R :=
  !![3*x^2*y^3*z + 6*x*y^4 + 6*x*y^2*z + 7*y^3 + 3*y*z,
     3*x^3*y^2*z + 12*x^2*y^3 + 6*x^2*y*z + 21*x*y^2 + 3*x*z + 8*y,
     x^3*y^3 + 3*x^2*y^2 + 3*x*y + 1;
     9*x^2*y^2*z + 18*x*y^3 + 12*x*y*z + 12*y^2 + 3*z,
     6*x^3*y*z + 27*x^2*y^2 + 6*x^2*z + 24*x*y + 1,
     3*x^3*y^2 + 6*x^2*y + 3*x;
     -3*x^2*z - 6*x*y + 2,
     -3*x^2,
     -x^3]

theorem jacobianMatrix_eq : jacobianMatrix = J := by
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j
  · first | exact d_f1_x | simpa [jacobianMatrix, F, J] using d_f1_x
  · first | exact d_f1_y | simpa [jacobianMatrix, F, J] using d_f1_y
  · first | exact d_f1_z | simpa [jacobianMatrix, F, J] using d_f1_z
  · first | exact d_f2_x | simpa [jacobianMatrix, F, J] using d_f2_x
  · first | exact d_f2_y | simpa [jacobianMatrix, F, J] using d_f2_y
  · first | exact d_f2_z | simpa [jacobianMatrix, F, J] using d_f2_z
  · first | exact d_f3_x | simpa [jacobianMatrix, F, J] using d_f3_x
  · first | exact d_f3_y | simpa [jacobianMatrix, F, J] using d_f3_y
  · first | exact d_f3_z | simpa [jacobianMatrix, F, J] using d_f3_z

/-- The determinant of the explicit matrix is the constant -2 (pure polynomial identity). -/
theorem det_J : J.det = -2 := by
  rw [Matrix.det_fin_three]
  simp [J]
  ring

theorem C_two : (C (2 : ℚ) : R) = 2 := by
  have h : (2 : ℚ) = 1 + 1 := by norm_num
  rw [h, map_add, map_one]
  norm_num

theorem det_jacobian : jacobianMatrix.det = C (-2 : ℚ) := by
  rw [jacobianMatrix_eq, det_J, map_neg, C_two]

/-! ## The collision -/

/-- The map on rational points. -/
noncomputable def Φ (p : Fin 3 → ℚ) : Fin 3 → ℚ :=
  ![eval p f1, eval p f2, eval p f3]

theorem Φ_a : Φ ![0, 0, -1/4] = ![-1/4, 0, 0] := by
  funext i
  fin_cases i <;> simp [Φ, f1, f2, f3, x, y, z] <;> norm_num

theorem Φ_b : Φ ![1, -3/2, 13/2] = ![-1/4, 0, 0] := by
  funext i
  fin_cases i <;> simp [Φ, f1, f2, f3, x, y, z] <;> norm_num

theorem Φ_c : Φ ![-1, 3/2, 13/2] = ![-1/4, 0, 0] := by
  funext i
  fin_cases i <;> simp [Φ, f1, f2, f3, x, y, z] <;> norm_num

theorem points_distinct :
    (![0, 0, -1/4] : Fin 3 → ℚ) ≠ ![1, -3/2, 13/2] ∧
    (![0, 0, -1/4] : Fin 3 → ℚ) ≠ ![-1, 3/2, 13/2] ∧
    (![1, -3/2, 13/2] : Fin 3 → ℚ) ≠ ![-1, 3/2, 13/2] := by
  refine ⟨?_, ?_, ?_⟩ <;> intro h <;> have := congrFun h 0 <;> norm_num at this

theorem not_injective : ¬ Function.Injective Φ := by
  intro h
  have hab : (![0, 0, -1/4] : Fin 3 → ℚ) = ![1, -3/2, 13/2] :=
    h (by rw [Φ_a, Φ_b])
  exact points_distinct.1 hab

/-- Constant nonzero Jacobian determinant, yet not injective on rational points. -/
theorem jacobian_counterexample :
    jacobianMatrix.det = C (-2 : ℚ) ∧ ¬ Function.Injective Φ :=
  ⟨det_jacobian, not_injective⟩

end JacobianCE

#print axioms JacobianCE.jacobian_counterexample
